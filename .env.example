# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Username for the admin panel (Basic Auth). Defaults to "admin" if unset.
ADMIN_USER=admin

# Password for the admin panel. REQUIRED — without this set, admin routes
# are left unprotected (a warning will print on server start).
ADMIN_PASSWORD=change-me-to-something-strong

# Port the server listens on. Most hosts (Render, Railway, etc.) set this
# automatically — you usually don't need to set it yourself in production.
PORT=3000
